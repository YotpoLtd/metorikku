# Ignore everything
**

# Allow files and directories
!/docker/**
!/target/scala-2.12/metorikku*.jar
!/target/scala-2.11/metorikku*.jar
!/examples/**

# Sources required to build metorikku.jar from scratch in the multi-stage
# docker/metorikku-spark35 image (its build stage runs `sbt assembly`).
!/build.sbt
!/version.sbt
!/project/**
!/src/**